# .env.example — Comments Feature Environment Variables
#
# Copy this file to .env.local for local development and populate each value.
# NEVER commit .env.local or any file containing real credentials.
#
# Vercel scoping guidance is noted per variable. Variables marked
# "Production-scoped" must be set in Vercel's Production environment only;
# use sandboxed/test credentials for Preview and Development environments.
# See: https://vercel.com/docs/projects/environment-variables/environments
#
# Phase 1 (Foundation) only requires DATABASE_URL to be set.
# All other variables are documented here so they can be populated
# incrementally as later phases land — no surprises at launch.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# DATABASE — Phase 1 required
# ---------------------------------------------------------------------------

# Neon Postgres connection string (pooled).
# Injected automatically by Vercel when you install the Neon integration from
# the Vercel Marketplace (Storage tab). The integration sets DATABASE_URL plus
# DATABASE_URL_UNPOOLED and several PG* helpers; our code only reads DATABASE_URL.
# For local development, run `vercel env pull .env.local`.
# Sensitivity: HIGH — grants full read/write access to the comments table.
# Vercel scoping: Production-scoped. Use a Neon branch URL for Preview/Dev.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# RATE LIMITING — Phase 5 required
# ---------------------------------------------------------------------------

# Upstash Redis REST endpoint. Create a free Upstash database and copy the
# REST URL from the database details page (not the redis:// URI).
# Sensitivity: MEDIUM — exposes rate-limit counters, not user data.
# Vercel scoping: Can be shared across environments (use a separate DB per env
# if you want isolated rate-limit state for Preview).
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io

# Upstash Redis REST auth token. Treat this as a password.
# Sensitivity: HIGH — grants full read/write to the Redis database.
# Vercel scoping: Production-scoped. Use a separate Upstash DB token for Preview.
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# ---------------------------------------------------------------------------
# TRANSACTIONAL EMAIL — Phase 5 required
# ---------------------------------------------------------------------------

# Resend API key. Generate from the Resend dashboard (API Keys tab).
# Required for owner notification emails when a new comment is submitted.
# Sensitivity: HIGH — allows sending email from your verified domain.
# Vercel scoping: Production-scoped. Use a test/sandbox key for Preview.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email address that Resend sends new-comment notifications TO (the owner's inbox).
# This is your personal/admin email — it never appears in the UI.
# Sensitivity: LOW — not secret, but keep out of client-side bundles.
# Vercel scoping: Production-scoped. Can use a personal inbox for Preview.
OWNER_NOTIFY_EMAIL=you@example.com

# Verified Resend sender address. Must be a domain you have verified in Resend.
# Appears in the From: field of notification emails.
# Sensitivity: LOW — public-facing but must match a Resend-verified domain.
# Vercel scoping: Production-scoped. Use onboarding@resend.dev for Preview only.
OWNER_FROM_EMAIL=comments@yourdomain.com

# ---------------------------------------------------------------------------
# OWNER AUTHENTICATION — Phase 3 required
# ---------------------------------------------------------------------------

# The owner's login password for the admin session (Iron Session).
# Used only in the POST /api/auth/login handler to authenticate the site owner.
# Must be at least 32 characters. Use a strong, randomly generated value.
# Generate: `openssl rand -base64 32`
# Sensitivity: CRITICAL — grants ability to delete any comment.
# Vercel scoping: Production-scoped. Use a separate dummy value for Preview.
OWNER_PASSWORD=replace-with-a-strong-password-of-at-least-32-chars

# Iron Session cookie encryption key. Used to sign and encrypt the httpOnly
# session cookie that authenticates the owner on DELETE requests.
# Must be exactly 32+ bytes of random data. Different from OWNER_PASSWORD.
# Generate: `openssl rand -hex 32`
# Sensitivity: CRITICAL — compromise allows session cookie forgery.
# Vercel scoping: Production-scoped. Use a separate randomly generated value for Preview.
IRON_SESSION_PASSWORD=replace-with-32-plus-bytes-of-random-hex-output

# HMAC signing secret for the one-click "delete comment" tokens embedded in
# owner notification emails (`/owner/comments/delete?token=...`). Must be at
# least 32 characters. Rotate this value to invalidate all outstanding tokens
# at once (e.g. if an email archive is suspected compromised).
# Generate: `openssl rand -hex 32`
# Sensitivity: CRITICAL — compromise allows forging delete tokens for ANY
# comment id without any other authentication.
# Vercel scoping: Production-scoped. Use a separate randomly generated value for Preview.
DELETE_TOKEN_SECRET=replace-with-32-plus-bytes-of-random-hex-output

# ---------------------------------------------------------------------------
# IP PRIVACY — Phase 2 required
# ---------------------------------------------------------------------------

# Salt for HMAC-SHA256 hashing of commenter IP addresses before they are
# stored in Redis (rate limiting) or the database. Ensures raw IPs never
# touch persistent storage. Must be at least 16 characters — the runtime
# guard in `lib/ipHash.ts` rejects shorter values (including placeholders
# like "dev" / "test"). Longer is better; 32+ recommended.
# Generate: `openssl rand -hex 32`
# Sensitivity: MEDIUM — knowledge of the salt allows de-anonymisation of
# stored IP hashes if an attacker also has the hashed values.
# Vercel scoping: Production-scoped. Use a separate random value for Preview.
IP_HASH_SALT=replace-with-random-hex-string-for-ip-hashing

# ---------------------------------------------------------------------------
# SITE METADATA — Phase 3 required
# ---------------------------------------------------------------------------

# The canonical public URL of the site (no trailing slash).
# Used for CSRF origin validation in the DELETE handler and for constructing
# signed one-click delete token links in moderation emails.
# Sensitivity: LOW — this is a public value, but must be exact.
# Vercel scoping: Set to the production URL for Production; Preview URL for Preview.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
